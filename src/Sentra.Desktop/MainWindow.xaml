<Window x:Class="Sentra.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SENTRA — Central Inteligente de Portaria"
        Width="1000"
        Height="650"
        MinWidth="800"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">
  <Grid>
    <Border Width="620"
            Padding="40"
            Background="White"
            BorderBrush="#D7DBE0"
            BorderThickness="1"
            CornerRadius="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="SENTRA" FontSize="36" FontWeight="SemiBold" Foreground="#162333" />
        <TextBlock Margin="0,6,0,28" Text="Central Inteligente de Portaria" FontSize="18" Foreground="#485766" />
        <TextBlock Text="Fundação técnica em configuração" FontSize="20" FontWeight="SemiBold" Foreground="#162333" />
        <TextBlock Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="#5A6672"
                   Text="Esta compilação é de desenvolvimento. Integrações externas somente serão exibidas como conectadas após validação real." />
        <Separator Margin="0,28,0,20" />
        <TextBlock Text="Desenvolvido por Samuel Sanches" FontSize="13" Foreground="#6B7680" />
        <TextBlock Margin="0,4,0,0"
                   Text="© 2026 Samuel Sanches. Todos os direitos reservados."
                   FontSize="12"
                   Foreground="#8A939C" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
