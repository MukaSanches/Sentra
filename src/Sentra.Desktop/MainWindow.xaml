<Window x:Class="Sentra.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SENTRA — Central Inteligente de Portaria"
        Width="1360"
        Height="820"
        MinWidth="1080"
        MinHeight="680"
        Background="{StaticResource SentraSurfaceBrush}"
        Loaded="OnLoaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="38"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource SentraNavyBrush}">
      <Grid Margin="24,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="SENTRA"
                     FontSize="24"
                     FontWeight="SemiBold"
                     Foreground="White"/>
          <TextBlock Text="Central Inteligente de Portaria"
                     FontSize="13"
                     Foreground="#D3DCE4"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding CurrentTitle}"
                     HorizontalAlignment="Right"
                     FontWeight="SemiBold"
                     Foreground="White"/>
          <TextBlock Text="WhatsApp oficial • Meta Cloud API"
                     HorizontalAlignment="Right"
                     FontSize="12"
                     Foreground="#B7C4CF"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="226"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{StaticResource SentraGraphiteBrush}">
        <DockPanel Margin="12,18">
          <StackPanel DockPanel.Dock="Bottom" Margin="12">
            <TextBlock Text="SENTRA 1.0"
                       Foreground="#ABB7C1"
                       FontSize="11"/>
            <TextBlock Text="Desenvolvido por Samuel Sanches"
                       Foreground="#ABB7C1"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
          </StackPanel>

          <StackPanel>
            <TextBlock Text="OPERAÇÃO"
                       Foreground="#83919C"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="12,0,0,8"/>
            <Button Style="{StaticResource SentraNavButton}"
                    Content="Conversas"
                    Command="{Binding ShowConversationsCommand}"/>
            <Button Style="{StaticResource SentraNavButton}"
                    Content="Administração"
                    Command="{Binding ShowAdministrationCommand}"/>
            <Button Style="{StaticResource SentraNavButton}"
                    Content="WhatsApp"
                    Command="{Binding ShowWhatsAppCommand}"/>

            <Separator Margin="6,14"
                       Background="#3A4A57"/>

            <TextBlock Text="SISTEMA"
                       Foreground="#83919C"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="12,0,0,8"/>
            <Button Style="{StaticResource SentraNavButton}"
                    Content="Conexão e acesso"
                    Command="{Binding ShowConnectionCommand}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <ContentControl Grid.Column="1"
                      Margin="24"
                      Content="{Binding CurrentPage}"/>
    </Grid>

    <Border Grid.Row="2" Background="#E5E9EC">
      <Grid Margin="24,0">
        <TextBlock VerticalAlignment="Center"
                   Text="SENTRA • Operação de portaria"/>
        <TextBlock HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Text="© 2026 Samuel Sanches"/>
      </Grid>
    </Border>
  </Grid>
</Window>
