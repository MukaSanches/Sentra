<Window x:Class="Sentra.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SENTRA — Central Inteligente de Portaria"
        Width="1280" Height="800" MinWidth="1024" MinHeight="680"
        Background="{StaticResource SentraSurfaceBrush}"
        Loaded="OnLoaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="38"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource SentraNavyBrush}">
      <Grid Margin="24,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="SENTRA" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock Text="Central Inteligente de Portaria" FontSize="13" Foreground="#D6DEE5"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="{Binding CurrentTitle}" HorizontalAlignment="Right" Foreground="White" FontWeight="SemiBold"/>
          <TextBlock Text="Operação M1" HorizontalAlignment="Right" Foreground="#B9C7D4" FontSize="12"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="228"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource SentraGraphiteBrush}">
        <DockPanel Margin="12,18">
          <TextBlock DockPanel.Dock="Bottom"
                     Margin="12"
                     Foreground="#AAB5BF"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Text="WhatsApp: M2&#x0a;Inteligência: M3"/>
          <StackPanel>
            <Button Style="{StaticResource SentraNavButton}" Content="Central operacional" Command="{Binding ShowDashboardCommand}"/>
            <Button Style="{StaticResource SentraNavButton}" Content="Blocos" Command="{Binding ShowBlocksCommand}"/>
            <Button Style="{StaticResource SentraNavButton}" Content="Unidades" Command="{Binding ShowUnitsCommand}"/>
            <Button Style="{StaticResource SentraNavButton}" Content="Moradores" Command="{Binding ShowResidentsCommand}"/>
            <Button Style="{StaticResource SentraNavButton}" Content="Usuários e permissões" Command="{Binding ShowUsersPermissionsCommand}"/>
            <Separator Margin="6,12" Background="#40505E"/>
            <Button Style="{StaticResource SentraNavButton}" Content="Configurações" Command="{Binding ShowConfigurationCommand}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <ContentControl Grid.Column="1"
                      Margin="24"
                      Content="{Binding CurrentPage}"/>
    </Grid>

    <Border Grid.Row="2" Background="#E5E9EC">
      <Grid Margin="24,0">
        <TextBlock VerticalAlignment="Center" Text="SENTRA 1.0.0 • M1 em validação"/>
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                   Text="Desenvolvido por Samuel Sanches"/>
      </Grid>
    </Border>
  </Grid>
</Window>
