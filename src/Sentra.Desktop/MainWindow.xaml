<Window x:Class="Sentra.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SENTRA — Central Inteligente de Portaria"
        Width="1120" Height="720" MinWidth="900" MinHeight="600"
        Background="{StaticResource SentraSurfaceBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="42"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource SentraNavyBrush}">
      <Grid Margin="24,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="SENTRA" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock Text="Central Inteligente de Portaria" FontSize="13" Foreground="#D6DEE5"/>
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#263B4F" CornerRadius="6" Padding="12,6">
          <TextBlock Text="M0 • Fundação" Foreground="White"/>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Margin="0,0,16,0" Padding="24" Background="White" CornerRadius="8">
        <StackPanel>
          <TextBlock Text="Central operacional" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource SentraGraphiteBrush}"/>
          <TextBlock Margin="0,8,0,24" Text="A estrutura base está instalada. As integrações reais serão ativadas conforme os marcos M1–M3." TextWrapping="Wrap" Foreground="#56616C"/>
          <TextBlock Text="Nenhuma integração é exibida como conectada sem validação real." FontWeight="SemiBold" Foreground="{StaticResource SentraAmberBrush}"/>
        </StackPanel>
      </Border>
      <StackPanel Grid.Column="1">
        <Border Margin="0,0,0,12" Padding="18" Background="White" CornerRadius="8">
          <StackPanel><TextBlock Text="Servidor" FontWeight="SemiBold"/><TextBlock Text="{Binding ServerStatus}" Margin="0,6,0,0" Foreground="{StaticResource SentraAmberBrush}"/></StackPanel>
        </Border>
        <Border Margin="0,0,0,12" Padding="18" Background="White" CornerRadius="8">
          <StackPanel><TextBlock Text="WhatsApp" FontWeight="SemiBold"/><TextBlock Text="{Binding WhatsAppStatus}" Margin="0,6,0,0" Foreground="{StaticResource SentraAmberBrush}"/></StackPanel>
        </Border>
        <Border Padding="18" Background="White" CornerRadius="8">
          <StackPanel><TextBlock Text="Inteligência" FontWeight="SemiBold"/><TextBlock Text="{Binding IntelligenceStatus}" Margin="0,6,0,0" Foreground="{StaticResource SentraAmberBrush}"/></StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    <Border Grid.Row="2" Background="#E8ECEF">
      <Grid Margin="24,0">
        <TextBlock VerticalAlignment="Center" Text="SENTRA 1.0.0"/>
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="Desenvolvido por Samuel Sanches"/>
      </Grid>
    </Border>
  </Grid>
</Window>
