<UserControl x:Class="Sentra.Desktop.Views.WhatsAppSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock Text="WhatsApp oficial"
                     FontSize="26"
                     FontWeight="SemiBold"/>
          <TextBlock Text="Meta WhatsApp Business Platform / Cloud API"
                     Foreground="#596671"
                     Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource SentraSecondaryButton}"
                  Content="Recarregar"
                  Command="{Binding LoadCatalogCommand}"/>
          <Button Style="{StaticResource SentraButton}"
                  Content="Validar integração"
                  Command="{Binding VerifyCommand}"/>
        </StackPanel>
      </Grid>

      <UniformGrid Columns="3" Margin="0,0,0,8">
        <Border Style="{StaticResource SentraCard}">
          <StackPanel>
            <TextBlock Text="Estado" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding State}" FontSize="18" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SentraCard}">
          <StackPanel>
            <TextBlock Text="Número" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding DisplayPhoneNumber, TargetNullValue=—}"
                       FontSize="18"
                       Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SentraCard}">
          <StackPanel>
            <TextBlock Text="Qualidade" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding QualityRating, TargetNullValue=—}"
                       FontSize="18"
                       Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Style="{StaticResource SentraCard}">
        <StackPanel>
          <TextBlock Text="Webhook do SENTRA"
                     FontSize="18"
                     FontWeight="SemiBold"/>
          <TextBlock Text="{Binding WebhookUrl}"
                     Margin="0,8,0,0"
                     TextWrapping="Wrap"/>
          <TextBlock Margin="0,10,0,0"
                     Foreground="#596671"
                     TextWrapping="Wrap"
                     Text="Cadastre esta URL como callback do WhatsApp na Meta. O Verify Token e o App Secret ficam somente no servidor."/>
        </StackPanel>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource SentraCard}">
          <StackPanel>
            <TextBlock Text="Templates"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <DataGrid ItemsSource="{Binding Templates}"
                      IsReadOnly="True"
                      Height="250"
                      Margin="0,12,0,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Idioma" Binding="{Binding Language}" Width="90"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Style="{StaticResource SentraCard}">
          <StackPanel>
            <TextBlock Text="Flows"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <DataGrid ItemsSource="{Binding Flows}"
                      IsReadOnly="True"
                      Height="250"
                      Margin="0,12,0,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>
      </Grid>

      <Border Style="{StaticResource SentraCard}">
        <StackPanel>
          <TextBlock Text="Configuração necessária no servidor"
                     FontSize="18"
                     FontWeight="SemiBold"/>
          <TextBlock Text="META_GRAPH_VERSION"
                     Margin="0,10,0,0"/>
          <TextBlock Text="META_APP_ID"/>
          <TextBlock Text="META_WABA_ID"/>
          <TextBlock Text="META_PHONE_NUMBER_ID"/>
          <TextBlock Text="META_ACCESS_TOKEN"/>
          <TextBlock Text="META_VERIFY_TOKEN"/>
          <TextBlock Text="META_APP_SECRET"/>
          <TextBlock Text="Nenhuma dessas credenciais é gravada ou exibida pelo aplicativo Windows."
                     Margin="0,10,0,0"
                     Foreground="{StaticResource SentraAmberBrush}"/>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Status}"
                 TextWrapping="Wrap"
                 Margin="4,0,4,12"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
