<UserControl x:Class="Sentra.Desktop.Views.AdministrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <TextBlock Text="Administração" FontSize="26" FontWeight="SemiBold"/>
      <Button HorizontalAlignment="Right" Style="{StaticResource SentraSecondaryButton}" Content="Atualizar" Command="{Binding RefreshCommand}"/>
    </Grid>
    <TabControl Grid.Row="1" Margin="0,14,0,0">
      <TabItem Header="Usuários">
        <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,14,0">
            <TextBlock Text="Novo usuário" FontSize="18" FontWeight="SemiBold"/>
            <TextBox Text="{Binding EmployeeName}" Margin="0,8,0,0" ToolTip="Nome completo"/>
            <TextBox Text="{Binding EmployeeUsername}" Margin="0,8,0,0" ToolTip="Login"/>
            <PasswordBox x:Name="EmployeePasswordBox" Margin="0,8,0,0" PasswordChanged="OnPasswordChanged"/>
            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name" Margin="0,8,0,0"/>
            <Button Style="{StaticResource SentraButton}" Content="Criar usuário" Command="{Binding CreateEmployeeCommand}" Margin="0,10,0,0"/>
          </StackPanel>
          <DataGrid Grid.Column="1" ItemsSource="{Binding Employees}" IsReadOnly="True"/>
        </Grid>
      </TabItem>
      <TabItem Header="Perfis e permissões">
        <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,14,0">
            <TextBlock Text="Novo perfil" FontSize="18" FontWeight="SemiBold"/>
            <TextBox Text="{Binding RoleName}" Margin="0,8,0,0"/>
            <TextBox Text="{Binding RoleDescription}" Margin="0,8,0,0"/>
            <TextBlock Text="Códigos de permissão separados por vírgula" Margin="0,8,0,0" Foreground="#596671"/>
            <TextBox Text="{Binding RolePermissionCodes}" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
            <Button Style="{StaticResource SentraButton}" Content="Criar perfil" Command="{Binding CreateRoleCommand}" Margin="0,10,0,0"/>
            <TextBlock Text="Permissões disponíveis" FontWeight="SemiBold" Margin="0,18,0,6"/>
            <ListBox ItemsSource="{Binding Permissions}" Height="220">
              <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2"><TextBlock Text="{Binding Code}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#596671"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
          <DataGrid Grid.Column="1" ItemsSource="{Binding Roles}" IsReadOnly="True"/>
        </Grid>
      </TabItem>
      <TabItem Header="Backup">
        <StackPanel Margin="18" MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Text="Backup e restauração" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="O arquivo é criptografado. A senha não é armazenada pelo SENTRA."
                     Margin="0,8,0,10" TextWrapping="Wrap" Foreground="#596671"/>
          <PasswordBox x:Name="BackupPasswordBox"
                       Width="340"
                       HorizontalAlignment="Left"
                       PasswordChanged="OnBackupPasswordChanged"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Style="{StaticResource SentraButton}"
                    Content="Salvar backup"
                    Click="OnExportBackupClick"/>
            <Button Style="{StaticResource SentraSecondaryButton}"
                    Content="Restaurar backup"
                    Click="OnRestoreBackupClick"/>
          </StackPanel>
          <TextBlock Text="Restauração: merge seguro no mesmo condomínio. Não apaga nem sobrescreve silenciosamente registros existentes."
                     Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#596671"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Importação">
        <StackPanel Margin="18" MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Text="Importar CSV / Excel" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Unidades: colunas unidade/identificador, nome e bloco opcional. Moradores: nome, telefone, unidade e vínculo opcional."
                     TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#596671"/>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource SentraButton}" Content="Importar unidades" Click="OnImportUnitsClick"/>
            <Button Style="{StaticResource SentraSecondaryButton}" Content="Importar moradores" Click="OnImportResidentsClick"/>
          </StackPanel>
          <TextBlock Text="Formatos aceitos: .csv e .xlsx. Linhas duplicadas são ignoradas; erros ficam descritos sem apagar dados existentes."
                     TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#596671"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Sistema">
        <StackPanel Margin="18">
          <TextBlock Text="Atualizações" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding UpdateStatus}" Margin="0,8,0,12"/>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource SentraButton}" Content="Verificar atualização" Command="{Binding CheckUpdateCommand}"/>
            <Button Style="{StaticResource SentraSecondaryButton}" Content="Abrir release" Command="{Binding OpenUpdateCommand}"/>
          </StackPanel>
          <TextBlock Text="O SENTRA verifica releases oficiais do repositório. Atualizações não são instaladas silenciosamente." TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#596671"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Auditoria">
        <DataGrid Margin="12" ItemsSource="{Binding Audit}" IsReadOnly="True"/>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="4,10,4,0" TextWrapping="Wrap"/>
  </Grid>
</UserControl>
