<UserControl x:Class="Sentra.Desktop.Views.ConversationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Conversas"
                   FontSize="26"
                   FontWeight="SemiBold"/>
        <TextBlock Text="Mensagens reais recebidas e enviadas pela Cloud API."
                   Foreground="#596671"
                   Margin="0,5,0,0"/>
      </StackPanel>
      <Button Grid.Column="1"
              Style="{StaticResource SentraSecondaryButton}"
              Content="Atualizar"
              Command="{Binding RefreshCommand}"/>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="290"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="330"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Style="{StaticResource SentraCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Text="Contatos"
                     FontSize="17"
                     FontWeight="SemiBold"/>

          <ListBox Grid.Row="1"
                   Margin="0,12,0,0"
                   BorderThickness="0"
                   ItemsSource="{Binding Conversations}"
                   SelectedItem="{Binding SelectedConversation}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="8" Margin="0,2">
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName, TargetNullValue=WhatsApp}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ExternalParticipantId}"
                               Foreground="#596671"
                               FontSize="12"/>
                    <TextBlock Text="{Binding LastMessageAt, StringFormat={}{0:dd/MM HH:mm}}"
                               Foreground="#7A858E"
                               FontSize="11"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Style="{StaticResource SentraCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="{Binding SelectedConversation.DisplayName, TargetNullValue=Selecione uma conversa}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SelectedConversation.ExternalParticipantId}"
                       Foreground="#596671"/>
          </StackPanel>

          <DataGrid Grid.Row="1"
                    Margin="0,12,0,12"
                    ItemsSource="{Binding Messages}"
                    SelectedItem="{Binding SelectedMessage}"
                    IsReadOnly="True"
                    HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Hora"
                                  Binding="{Binding OccurredAt, StringFormat={}{0:HH:mm}}"
                                  Width="65"/>
              <DataGridTextColumn Header="Direção"
                                  Binding="{Binding Direction}"
                                  Width="80"/>
              <DataGridTextColumn Header="Tipo"
                                  Binding="{Binding ContentKind}"
                                  Width="95"/>
              <DataGridTextColumn Header="Mensagem"
                                  Binding="{Binding Text}"
                                  Width="*"/>
              <DataGridTextColumn Header="Estado"
                                  Binding="{Binding DeliveryStatus}"
                                  Width="100"/>
            </DataGrid.Columns>
          </DataGrid>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource SentraTextBox}"
                     AcceptsReturn="True"
                     MaxHeight="90"
                     TextWrapping="Wrap"
                     Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource SentraButton}"
                    Content="Enviar"
                    Command="{Binding SendTextCommand}"/>
          </Grid>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="2"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource SentraCard}">
            <StackPanel>
              <TextBlock Text="Template aprovado"
                         FontWeight="SemiBold"/>
              <ComboBox Style="{StaticResource SentraComboBox}"
                        ItemsSource="{Binding Templates}"
                        SelectedItem="{Binding SelectedTemplate}"
                        DisplayMemberPath="Name"/>
              <TextBlock Text="Parâmetros do corpo separados por |"
                         FontSize="11"
                         Foreground="#596671"
                         Margin="4,6,4,0"/>
              <TextBox Style="{StaticResource SentraTextBox}"
                       Text="{Binding TemplateParameters, UpdateSourceTrigger=PropertyChanged}"/>
              <Button Style="{StaticResource SentraButton}"
                      Content="Enviar template"
                      Command="{Binding SendTemplateCommand}"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SentraCard}">
            <StackPanel>
              <TextBlock Text="Confirmação rápida"
                         FontWeight="SemiBold"/>
              <TextBox Style="{StaticResource SentraTextBox}"
                       Text="{Binding InteractiveBody, UpdateSourceTrigger=PropertyChanged}"/>
              <Button Style="{StaticResource SentraButton}"
                      Content="Enviar Confirmar / Negar"
                      Command="{Binding SendConfirmationButtonsCommand}"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SentraCard}">
            <StackPanel>
              <TextBlock Text="WhatsApp Flow"
                         FontWeight="SemiBold"/>
              <ComboBox Style="{StaticResource SentraComboBox}"
                        ItemsSource="{Binding Flows}"
                        SelectedItem="{Binding SelectedFlow}"
                        DisplayMemberPath="Name"/>
              <TextBlock Text="Texto" FontSize="11" Foreground="#596671" Margin="4,6,4,0"/>
              <TextBox Style="{StaticResource SentraTextBox}"
                       Text="{Binding FlowBody, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Text="Botão" FontSize="11" Foreground="#596671" Margin="4,6,4,0"/>
              <TextBox Style="{StaticResource SentraTextBox}"
                       Text="{Binding FlowCallToAction, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Text="Tela inicial opcional" FontSize="11" Foreground="#596671" Margin="4,6,4,0"/>
              <TextBox Style="{StaticResource SentraTextBox}"
                       Text="{Binding FlowScreen, UpdateSourceTrigger=PropertyChanged}"/>
              <Button Style="{StaticResource SentraButton}"
                      Content="Enviar Flow"
                      Command="{Binding SendFlowCommand}"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SentraCard}">
            <StackPanel>
              <TextBlock Text="Mídia"
                         FontWeight="SemiBold"/>
              <Button Style="{StaticResource SentraSecondaryButton}"
                      Content="Enviar imagem"
                      Click="OnSendImageClick"/>
              <Button Style="{StaticResource SentraSecondaryButton}"
                      Content="Enviar documento"
                      Click="OnSendDocumentClick"/>
              <Button Style="{StaticResource SentraSecondaryButton}"
                      Content="Enviar áudio"
                      Click="OnSendAudioClick"/>
              <Button Style="{StaticResource SentraSecondaryButton}"
                      Content="Enviar vídeo"
                      Click="OnSendVideoClick"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SentraCard}">
            <StackPanel>
              <TextBlock Text="Anexos da mensagem"
                         FontWeight="SemiBold"/>
              <ListBox ItemsSource="{Binding Attachments}"
                       SelectedItem="{Binding SelectedAttachment, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWayToSource}"
                       Margin="0,8,0,8">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="2,4">
                      <TextBlock Text="{Binding FileName, TargetNullValue=Anexo}"/>
                      <TextBlock Text="{Binding MimeType}"
                                 Foreground="#596671"
                                 FontSize="11"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Style="{StaticResource SentraSecondaryButton}"
                      Content="Salvar anexo selecionado"
                      Click="OnDownloadAttachmentClick"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <TextBlock Grid.Row="2"
               Margin="4,10,4,0"
               Text="{Binding Status}"
               TextWrapping="Wrap"
               Foreground="#596671"/>
  </Grid>
</UserControl>
