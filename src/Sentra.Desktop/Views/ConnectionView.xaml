<UserControl x:Class="Sentra.Desktop.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="920"
                HorizontalAlignment="Left">
      <TextBlock Text="Conexão e acesso"
                 FontSize="26"
                 FontWeight="SemiBold"/>
      <TextBlock Text="O SENTRA valida o servidor e mantém a sessão somente em memória."
                 Foreground="#596671"
                 Margin="0,6,0,18"/>

      <Border Style="{StaticResource SentraCard}">
        <StackPanel>
          <TextBlock Text="Servidor"
                     FontSize="18"
                     FontWeight="SemiBold"/>

          <TextBlock Text="URL da API"
                     FontWeight="SemiBold"
                     Margin="4,14,4,0"/>
          <TextBox Style="{StaticResource SentraTextBox}"
                   Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"/>

          <TextBlock Text="ID do condomínio"
                     FontWeight="SemiBold"
                     Margin="4,8,4,0"/>
          <TextBox Style="{StaticResource SentraTextBox}"
                   Text="{Binding CondominiumIdText, UpdateSourceTrigger=PropertyChanged}"/>

          <TextBlock Text="Usuário"
                     FontWeight="SemiBold"
                     Margin="4,8,4,0"/>
          <TextBox Style="{StaticResource SentraTextBox}"
                   Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

          <TextBlock Text="Senha"
                     FontWeight="SemiBold"
                     Margin="4,8,4,0"/>
          <PasswordBox x:Name="LoginPassword"
                       Style="{StaticResource SentraPasswordBox}"/>

          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{StaticResource SentraButton}"
                    Content="Entrar"
                    Click="OnLoginClick"/>
            <Button Style="{StaticResource SentraSecondaryButton}"
                    Content="Testar servidor"
                    Command="{Binding TestServerCommand}"/>
            <Button Style="{StaticResource SentraSecondaryButton}"
                    Content="Salvar"
                    Command="{Binding SaveCommand}"/>
            <Button Style="{StaticResource SentraSecondaryButton}"
                    Content="Sair da sessão"
                    Command="{Binding LogoutCommand}"/>
          </StackPanel>

          <Grid Margin="4,14,4,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Servidor"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding ServerStatus}"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1"
                       Text="Setup"
                       Margin="0,6,0,0"/>
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding SetupStatus}"
                       FontWeight="SemiBold"
                       Margin="0,6,0,0"/>
            <TextBlock Grid.Row="2"
                       Text="Sessão"
                       Margin="0,6,0,0"/>
            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       Text="{Binding AuthenticationStatus}"
                       FontWeight="SemiBold"
                       Margin="0,6,0,0"/>
          </Grid>
        </StackPanel>
      </Border>

      <Expander Header="Configuração inicial do primeiro condomínio"
                Margin="0,0,12,12">
        <Border Style="{StaticResource SentraCard}">
          <StackPanel>
            <TextBlock Text="Este processo só funciona uma vez e exige o token de bootstrap configurado no servidor."
                       TextWrapping="Wrap"
                       Foreground="#596671"/>

            <TextBlock Text="Nome do condomínio" FontWeight="SemiBold" Margin="4,12,4,0"/>
            <TextBox x:Name="BootstrapCondominiumName" Style="{StaticResource SentraTextBox}"/>

            <TextBlock Text="Nome do administrador" FontWeight="SemiBold" Margin="4,8,4,0"/>
            <TextBox x:Name="BootstrapAdministratorName" Style="{StaticResource SentraTextBox}"/>

            <TextBlock Text="Usuário do administrador" FontWeight="SemiBold" Margin="4,8,4,0"/>
            <TextBox x:Name="BootstrapUsername" Style="{StaticResource SentraTextBox}"/>

            <TextBlock Text="Senha do administrador" FontWeight="SemiBold" Margin="4,8,4,0"/>
            <PasswordBox x:Name="BootstrapPassword" Style="{StaticResource SentraPasswordBox}"/>

            <TextBlock Text="Token de bootstrap do servidor" FontWeight="SemiBold" Margin="4,8,4,0"/>
            <PasswordBox x:Name="BootstrapToken" Style="{StaticResource SentraPasswordBox}"/>

            <Button HorizontalAlignment="Left"
                    Style="{StaticResource SentraButton}"
                    Content="Executar configuração inicial"
                    Click="OnBootstrapClick"/>
          </StackPanel>
        </Border>
      </Expander>

      <TextBlock Text="{Binding Status}"
                 TextWrapping="Wrap"
                 Margin="4,0,4,12"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
