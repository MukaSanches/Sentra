<UserControl x:Class="Sentra.Desktop.Views.UsersPermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Usuários e permissões" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock Text="RBAC aplicado no servidor; a interface não é a barreira de segurança."
                   Foreground="#596671" Margin="0,5,0,0"/>
      </StackPanel>
      <Button Grid.Column="1" Style="{StaticResource SentraButton}" Content="Recarregar" Command="{Binding LoadCommand}"/>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.1*"/>
        <ColumnDefinition Width="1.2*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource SentraCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Funcionários" FontSize="18" FontWeight="SemiBold"/>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}"
                    Margin="0,12,0,12" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nome" Binding="{Binding FullName}" Width="*"/>
              <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding IsActive}" Width="70"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2">
            <TextBlock Text="Atribuir papel selecionado" FontWeight="SemiBold"/>
            <Button Style="{StaticResource SentraButton}" Content="Atribuir ao funcionário"
                    Command="{Binding AssignRoleCommand}"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource SentraCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Text="Papéis" FontSize="18" FontWeight="SemiBold"/>

          <Grid Grid.Row="1" Margin="0,10,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource SentraTextBox}" Text="{Binding NewRoleName, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="1" Style="{StaticResource SentraButton}" Content="Criar papel" Command="{Binding CreateRoleCommand}"/>
          </Grid>

          <DataGrid Grid.Row="2" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
              <DataGridCheckBoxColumn Header="Sistema" Binding="{Binding IsSystem}" Width="80"/>
            </DataGrid.Columns>
          </DataGrid>

          <ItemsControl Grid.Row="3" ItemsSource="{Binding Permissions}" Margin="0,12,0,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected}" Margin="2,5">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" Width="190"/>
                    <TextBlock Text="{Binding Code}" Foreground="#66727C"/>
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Grid.Row="4" Style="{StaticResource SentraButton}"
                  Content="Aplicar permissões ao papel" Command="{Binding ApplyPermissionsCommand}"/>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" Margin="4,12,4,0" Text="{Binding Status}" Foreground="#596671"/>
  </Grid>
</UserControl>
